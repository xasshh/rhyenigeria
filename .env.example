APP_NAME="Rhye Nigeria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rhyenigeria
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset emails. "log" writes them to storage/logs/laravel.log.
# For real email, switch to smtp and fill in your provider's details, e.g.:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps            # or leave null for STARTTLS on port 587
#   MAIL_HOST=smtp.example.com
#   MAIL_PORT=465
#   MAIL_USERNAME=no-reply@rhyenigeria.org
#   MAIL_PASSWORD=your-smtp-password
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rhyenigeria.org"
MAIL_FROM_NAME="Renewed Hope Youth Engagement"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the Reverb server process listens
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Where clients (and Laravel) reach Reverb
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Location tracking
TRACKING_RETENTION_DAYS=90
TRACKING_RATE_LIMIT_PER_MINUTE=60
TRACKING_MAX_BATCH_SIZE=500
TRACKING_CONSENT_VERSION=1

# Field data photos
SUBMISSION_PHOTO_MAX_KB=8192
SUBMISSION_MAX_PHOTOS=5

# Public sign-up and membership
MEMBERSHIP_CONSENT_VERSION=1
JOIN_RATE_LIMIT_PER_MINUTE=30
# Where "Get help" on the sign-in and join screens points (WhatsApp or mailto: link). Empty = the privacy notice.
HELP_URL=
EMPOWERMENT_PHOTO_MAX_KB=8192

# Only read by `php artisan db:seed --class=SuperAdminSeeder`; pass on the command line, do not store here.
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
